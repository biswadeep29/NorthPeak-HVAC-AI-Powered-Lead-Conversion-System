    {
      "parameters": {
        "jsCode": "const fields = $input.first().json.body.data.fields;\n\n// Helper to extract value by label\nfunction getVal(label) {\n  const field = fields.find(f => f.label === label);\n  if (!field) return \"\";\n  \n  // For multiple choice (has options array), resolve the selected ID to text\n  if (field.options && field.value) {\n    const selected = Array.isArray(field.value) ? field.value : [field.value];\n    return selected\n      .map(id => field.options.find(o => o.id === id)?.text || id)\n      .join(\", \");\n  }\n  \n  return field.value || \"\";\n}\n\nreturn [{\n  json: {\n    name:        getVal(\"Full Name\"),\n    email:       getVal(\"Email address\"),\n    phone:       getVal(\"Phone Number\"),\n    service:     getVal(\"Service Needed\"),\n    urgency:     getVal(\"Urgency Dropdown\"),\n    budget:      getVal(\"Budget Range\"),\n    city:        getVal(\"Location - City / ZIP\"),\n    description: getVal(\"Brief description\"),\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
